<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below backup rules (the pre-Android-12 counterpart of
  data_extraction_rules.xml). A phone that upgrades or restores on an older
  release uses this file instead.
-->
<!--
  Only what Doorstep owns is included: cache and external files are never
  part of an include, so there is nothing to exclude.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
</full-backup-content>
